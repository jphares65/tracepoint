# syntax=docker/dockerfile:1
FROM public.ecr.aws/docker/library/node:24-trixie-slim AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY src/lib/email ./src/lib/email
COPY scripts/staging-ses-app-provider-proof.mjs ./scripts/staging-ses-app-provider-proof.mjs
RUN ./node_modules/.bin/esbuild ./scripts/staging-ses-app-provider-proof.mjs \
    --bundle --platform=node --format=cjs --target=node24 --external:pg-native \
    --outfile=/app/staging-ses-app-provider-proof.cjs
ADD https://truststore.pki.rds.amazonaws.com/us-east-1/us-east-1-bundle.pem /app/rds-ca.pem
RUN test -r /app/rds-ca.pem && grep -q 'BEGIN CERTIFICATE' /app/rds-ca.pem

FROM gcr.io/distroless/nodejs24-debian13:nonroot
WORKDIR /app
COPY --from=builder --chown=nonroot:nonroot /app/staging-ses-app-provider-proof.cjs ./staging-ses-app-provider-proof.cjs
COPY --from=builder --chown=nonroot:nonroot /app/rds-ca.pem ./rds-ca.pem
USER nonroot
ENTRYPOINT ["/nodejs/bin/node", "/app/staging-ses-app-provider-proof.cjs"]
