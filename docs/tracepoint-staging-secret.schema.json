{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracepointhq.com/schemas/tracepoint-staging-secret.schema.json",
  "title": "TracePoint staging application secret",
  "description": "Key names and constraints only. Never commit an instance containing values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "SUPABASE_SECRET_KEY",
    "BREVO_API_KEY",
    "NOTIFICATION_DISPATCH_SECRET",
    "NEXT_SERVER_ACTIONS_ENCRYPTION_KEY",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_SITE_URL",
    "CONFIGURATION_ENVIRONMENT",
    "TRACEPOINT_IMPORT_APPROVAL_SECRET",
    "TRACEPOINT_AUTH_STATE_KEYS",
    "TRACEPOINT_AUTH_REFRESH_KEYS"
  ],
  "properties": {
    "SUPABASE_SECRET_KEY": { "type": "string", "minLength": 1 },
    "BREVO_API_KEY": { "type": "string", "minLength": 1 },
    "NOTIFICATION_DISPATCH_SECRET": { "type": "string", "minLength": 32 },
    "NEXT_SERVER_ACTIONS_ENCRYPTION_KEY": {
      "type": "string",
      "contentEncoding": "base64",
      "description": "Base64 for exactly 16, 24, or 32 decoded bytes; validated by the population script."
    },
    "NEXT_PUBLIC_SUPABASE_URL": { "type": "string", "format": "uri", "pattern": "^https://" },
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": { "type": "string", "minLength": 1 },
    "NEXT_PUBLIC_SITE_URL": { "const": "https://staging.tracepointhq.com" },
    "CONFIGURATION_ENVIRONMENT": { "const": "staging" },
    "TRACEPOINT_IMPORT_APPROVAL_SECRET": { "type": "string", "minLength": 43, "maxLength": 43, "pattern": "^[A-Za-z0-9_-]{43}$" },
    "TRACEPOINT_AUTH_STATE_KEYS": { "type": "string", "contentMediaType": "application/json", "description": "Versioned active-key JSON keyring; tooling validates one to three independent 32-byte base64url keys." },
    "TRACEPOINT_AUTH_REFRESH_KEYS": { "type": "string", "contentMediaType": "application/json", "description": "Independent versioned active-key JSON keyring; tooling validates one to three 32-byte base64url keys." }
  }
}
