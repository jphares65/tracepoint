FROM public.ecr.aws/docker/library/node:24-alpine AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

FROM public.ecr.aws/docker/library/node:24-alpine
RUN apk upgrade --no-cache && apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY scripts/supabase-rest-ledger-core.mjs scripts/supabase-rest-import-core.mjs scripts/immutable-source-artifact-validator.mjs scripts/run-supabase-rest-initial-import.mjs ./scripts/
COPY scripts/source-production-final-capture-core.mjs scripts/source-frozen-capture-parity-core.mjs ./scripts/
COPY scripts/production-final-import-core.mjs scripts/production-final-atomic-import-core.mjs scripts/production-final-relation-adapter.mjs ./scripts/
COPY scripts/production-final-object-archive-core.mjs scripts/production-final-object-copy-core.mjs ./scripts/
COPY scripts/run-production-final-atomic-import.mjs scripts/run-production-final-object-copy.mjs scripts/run-production-final-import-task.mjs scripts/run-isolated-final-import-proof.mjs ./scripts/
ADD https://truststore.pki.rds.amazonaws.com/us-east-1/us-east-1-bundle.pem /app/rds-ca.pem
RUN chmod 444 /app/rds-ca.pem
USER node
ENTRYPOINT ["node", "scripts/run-production-final-import-task.mjs"]
