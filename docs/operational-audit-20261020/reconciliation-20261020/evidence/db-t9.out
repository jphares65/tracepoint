-- T9 step 7: which DB functions can move cognito link pending->active?
select p.oid::regprocedure from pg_proc p join pg_namespace n on n.oid=p.pronamespace where n.nspname in ('public','tracepoint_auth') and pg_get_functiondef(p.oid) ~* 'set\s+state\s*=\s*''active''' order by 1
ERROR:  "array_agg" is an aggregate function
