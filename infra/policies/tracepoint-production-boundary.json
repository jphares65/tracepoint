{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowProductionAdministrationExceptReservedChanges",
      "Effect": "Allow",
      "NotAction": [
        "organizations:*",
        "account:*",
        "route53:*",
        "route53domains:*",
        "cognito-idp:*",
        "ses:*",
        "iam:PassRole",
        "iam:CreateServiceLinkedRole",
        "iam:CreateUser",
        "iam:CreateAccessKey",
        "iam:UpdateAccessKey",
        "iam:DeleteAccessKey",
        "iam:CreateLoginProfile",
        "iam:UpdateLoginProfile",
        "iam:CreateServiceSpecificCredential",
        "iam:UploadSigningCertificate"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowReadOnlyReservedServices",
      "Effect": "Allow",
      "Action": [
        "organizations:Describe*",
        "organizations:List*",
        "account:Get*",
        "route53:Get*",
        "route53:List*",
        "route53:TestDNSAnswer",
        "route53domains:Get*",
        "route53domains:List*",
        "cognito-idp:Describe*",
        "cognito-idp:Get*",
        "cognito-idp:List*",
        "ses:Get*",
        "ses:List*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowReviewedSesFoundationCreationViaCloudFormation",
      "Effect": "Allow",
      "Action": [
        "ses:CreateConfigurationSet",
        "ses:CreateEmailIdentity"
      ],
      "Resource": "*",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::193644343389:role/cdk-hnb659fds-cfn-exec-role-193644343389-us-east-1"
        }
      }
    },
    {
      "Sid": "AllowReviewedSesFoundationResources",
      "Effect": "Allow",
      "Action": [
        "ses:DeleteConfigurationSet",
        "ses:CreateConfigurationSetEventDestination",
        "ses:DeleteConfigurationSetEventDestination",
        "ses:UpdateConfigurationSetEventDestination",
        "ses:PutConfigurationSetDeliveryOptions",
        "ses:PutConfigurationSetReputationOptions",
        "ses:PutConfigurationSetSuppressionOptions",
        "ses:DeleteEmailIdentity",
        "ses:PutEmailIdentityConfigurationSetAttributes",
        "ses:PutEmailIdentityDkimAttributes",
        "ses:PutEmailIdentityDkimSigningAttributes",
        "ses:PutEmailIdentityFeedbackAttributes",
        "ses:PutEmailIdentityMailFromAttributes",
        "ses:TagResource",
        "ses:UntagResource"
      ],
      "Resource": [
        "arn:aws:ses:us-east-1:193644343389:identity/tracepointhq.com",
        "arn:aws:ses:us-east-1:193644343389:configuration-set/tracepoint-production",
        "arn:aws:ses:us-east-1:193644343389:configuration-set/tracepoint-production-cognito"
      ],
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": [
            "arn:aws:iam::193644343389:role/TracePointMigrationProduction",
            "arn:aws:iam::193644343389:role/cdk-hnb659fds-cfn-exec-role-193644343389-us-east-1"
          ]
        }
      }
    },
    {
      "Sid": "AllowReviewedSesAccountControls",
      "Effect": "Allow",
      "Action": [
        "ses:PutAccountDetails",
        "ses:PutAccountSuppressionAttributes"
      ],
      "Resource": "*",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::193644343389:role/TracePointMigrationProduction"
        }
      }
    },
    {
      "Sid": "AllowReviewedRoute53RecordChangesViaCloudFormation",
      "Effect": "Allow",
      "Action": "route53:ChangeResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/Z06725946QWMQBKB1JT8",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::193644343389:role/cdk-hnb659fds-cfn-exec-role-193644343389-us-east-1"
        },
        "ForAllValues:StringEquals": {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": [
            "tracepointhq.com",
            "www.tracepointhq.com",
            "_cf183eaeec77acfda74681d687456469.tracepointhq.com",
            "staging.tracepointhq.com",
            "_cf391b761ec604139a02ad89ac26fc3b.staging.tracepointhq.com",
            "autodiscover.tracepointhq.com",
            "sip.tracepointhq.com",
            "lyncdiscover.tracepointhq.com",
            "enterpriseregistration.tracepointhq.com",
            "enterpriseenrollment.tracepointhq.com",
            "_sip._tls.tracepointhq.com",
            "_sipfederationtls._tcp.tracepointhq.com",
            "send.tracepointhq.com",
            "r.send.tracepointhq.com",
            "img.send.tracepointhq.com",
            "brevo1._domainkey.tracepointhq.com",
            "brevo2._domainkey.tracepointhq.com",
            "t3pxf5n23dcf5ahxn4xzhcxfxnvushzh._domainkey.tracepointhq.com",
            "yiaen5uag5n6evooqpo2rt3earh3zwcq._domainkey.tracepointhq.com",
            "yabannzf7xcqdnbgbxoee5k2c77xktci._domainkey.tracepointhq.com",
            "3drryitjdubjinnkgryh3tbpzxoinewk._domainkey.staging.tracepointhq.com",
            "e5uy6cdpk3j3wy2iezyywdqqqqhoerdu._domainkey.staging.tracepointhq.com",
            "vzklmpevtuvf4g3sqev3y3z7eknsmsu5._domainkey.staging.tracepointhq.com",
            "bounce.tracepointhq.com",
            "bounce.staging.tracepointhq.com",
            "_dmarc.tracepointhq.com"
          ],
          "route53:ChangeResourceRecordSetsRecordTypes": ["A", "CNAME", "MX", "SRV", "TXT"],
          "route53:ChangeResourceRecordSetsActions": ["CREATE", "UPSERT", "DELETE"]
        },
        "Null": {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": "false",
          "route53:ChangeResourceRecordSetsRecordTypes": "false",
          "route53:ChangeResourceRecordSetsActions": "false"
        }
      }
    },
    {
      "Sid": "AllowPassOnlyTracePointAndCdkRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::193644343389:role/TracePoint-*",
        "arn:aws:iam::193644343389:role/tracepoint-*",
        "arn:aws:iam::193644343389:role/cdk-hnb659fds-*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "cloudformation.amazonaws.com",
            "cloudtrail.amazonaws.com",
            "config.amazonaws.com",
            "vpc-flow-logs.amazonaws.com",
            "lambda.amazonaws.com",
            "ecs-tasks.amazonaws.com",
            "codebuild.amazonaws.com",
            "application-autoscaling.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "AllowRequiredServiceLinkedRoles",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "ecs.amazonaws.com",
            "elasticloadbalancing.amazonaws.com",
            "guardduty.amazonaws.com",
            "config.amazonaws.com",
            "securityhub.amazonaws.com",
            "securityhubv2.amazonaws.com",
            "ecs.application-autoscaling.amazonaws.com"
          ]
        }
      }
    }
  ]
}
