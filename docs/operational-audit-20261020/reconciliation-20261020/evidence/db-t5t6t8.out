-- T5 ADM-03: no-membership user, beginSubject-style context (subject only), calls create_department_with_owner
begin;
BEGIN
set local role authenticated;
SET
select set_config('tracepoint.subject_id','80000000-0000-4000-8000-000000000001',true) is not null;
 ?column? 
----------
 t
(1 row)

select exists(select 1 from public.department_memberships where user_id='80000000-0000-4000-8000-000000000001') as had_membership_before;
 had_membership_before 
-----------------------
 f
(1 row)

select public.create_department_with_owner('Rogue Agency','rogue-agency','RA') as new_department_id;
          new_department_id           
--------------------------------------
 94a537f2-95ba-47b5-836f-750545e49c9a
(1 row)

select d.name, m.is_active, r.role_code, public.has_department_permission(d.id,'administer_department') admin_perm from public.departments d join public.department_memberships m on m.department_id=d.id join public.department_membership_roles r on r.department_id=d.id and r.user_id=m.user_id where d.slug='rogue-agency';
     name     | is_active |   role_code   | admin_perm 
--------------+-----------+---------------+------------
 Rogue Agency | t         | administrator | t
(1 row)

commit;
COMMIT
