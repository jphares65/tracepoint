# syntax=docker/dockerfile:1
FROM public.ecr.aws/docker/library/node:24-trixie-slim AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY scripts/isolated-ses-app-provider-proof.mjs ./scripts/
COPY src/lib/email ./src/lib/email
ADD https://truststore.pki.rds.amazonaws.com/us-east-1/us-east-1-bundle.pem /app/rds-ca.pem
RUN test -r /app/rds-ca.pem && grep -q 'BEGIN CERTIFICATE' /app/rds-ca.pem
RUN ./node_modules/.bin/esbuild scripts/isolated-ses-app-provider-proof.mjs \
    --bundle --platform=node --format=cjs --target=node24 --external:pg-native \
    --outfile=/app/isolated-ses-app-provider-proof.cjs

FROM gcr.io/distroless/nodejs24-debian13:nonroot
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder --chown=nonroot:nonroot /app/rds-ca.pem /app/rds-ca.pem
COPY --from=builder --chown=nonroot:nonroot /app/isolated-ses-app-provider-proof.cjs /app/isolated-ses-app-provider-proof.cjs
USER nonroot
CMD ["isolated-ses-app-provider-proof.cjs"]
